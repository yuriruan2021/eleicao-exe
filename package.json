{
  "name": "eleicao-exe",
  "private": true,
  "version": "0.1.0",
  "description": "Central de acompanhamento eleitoral não-oficial™ — apuração presidencial 2026 entre amigos.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c magenta,cyan \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p server/tsconfig.json",
    "build": "npm run typecheck && vite build",
    "start": "tsx server/index.ts"
  },
  "dependencies": {
    "@radix-ui/react-switch": "^1.1.3",
    "@tanstack/react-query": "^5.75.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.1.0",
    "lucide-react": "latest",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.0.0",
    "tailwind-merge": "^3.0.2",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.2"
  }
}
